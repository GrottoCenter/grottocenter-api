<%# Cave page. Locals: model (see botPageModel.js); nothing else is available -%>
<% const model = locals.model; const labels = model.labels; -%>
<%- include('_breadcrumb', { breadcrumb: model.breadcrumb }) -%>
<h1><%= model.name %></h1>
<%- include('_facts', { facts: model.facts }) -%>
<% if (model.massifs.length) { %><h2><%= labels.massifs %></h2>
<ul>
<% model.massifs.forEach((massif) => { %><li><a href="<%= massif.url %>"><%= massif.name %></a></li>
<% }) %></ul>
<% } %><% if (model.descriptions.length) { %><h2><%= labels.descriptions %></h2>
<%- include('_descriptions', { descriptions: model.descriptions, level: 3 }) -%>
<% } %><% if (model.entrances.length) { %><h2><%= labels.entrances %></h2>
<% model.entrances.forEach((entrance) => { %>
<section>
<h3><%= entrance.name || labels.entrance %></h3>
<%- include('_facts', { facts: entrance.facts }) -%>
<%- include('_descriptions', { descriptions: entrance.descriptions, level: 4 }) -%>
</section>
<% }) %><% } %>
