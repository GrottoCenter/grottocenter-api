<%# Organization page. Locals: model (see botPageModel.js); nothing else is available -%>
<% const model = locals.model; const labels = model.labels; -%>
<h1><%= model.name %></h1>
<%- include('_facts', { facts: model.facts }) -%>
<% if (model.website) { %><dl>
<dt><%= labels.website %></dt><dd><a href="<%= model.website %>" rel="nofollow ugc"><%= model.website %></a></dd>
</dl>
<% } %>
