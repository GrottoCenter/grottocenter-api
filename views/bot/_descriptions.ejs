<%# Locals: descriptions (array of {title, body, language}), pageLanguage -%>
<% locals.descriptions.forEach((description) => { %>
<section>
<% if (description.title) { %><h3<% if (description.language && description.language !== locals.pageLanguage) { %> lang="<%= description.language %>"<% } %>><%= description.title %></h3>
<% } %><% if (description.body) { %><p class="text"<% if (description.language && description.language !== locals.pageLanguage) { %> lang="<%= description.language %>"<% } %>><%= description.body %></p>
<% } %></section>
<% }) %>
