<%- include('emailHeader', { emailTitle: emailTitle, locale: locale }); %>
  <% /*
    =====EMAIL BODY=====

      Required values: 
        - __            Function    locale-scoped translation helper
        - locale        String      ISO 639-1 locale code
        - recipientName String      Full name or nickname of the recipient 
        - verifyLink    String      Link allowing the recipient to verify their email address 
    */ %>

  <p><%- __('Dear %s', '<b>' +recipientName+'</b>') %></p>

  <p>
    <%- __('Thank you for creating your Grottocenter account.') %>
    <%- __('Please verify your email address by clicking the link below.') %>
    <%- __("If you didn't create an account, you can ignore this email.")%>
  </p>

  <p>
    <a href="<%= verifyLink %>">
      <%- __('Verify my email address') %>
    </a>
  </p>

  <%- include('emailFooter', { __: __, locale: locale }); %>
