<%- include('emailHeader', { emailTitle: emailTitle, locale: locale }); %>
<% /*
===== EMAIL BODY =====
    Required values:
        - __                Function    locale-scoped translation helper
        - emailTitle        String      Subject line used as HTML <title>
        - locale            String      ISO 639-1 locale code
        - recipientName     String      Full name or nickname of the recipient
        - resetLink         String      Link allowing the recipient to reset is password
*/ %>

<p><%- __('Dear %s', '<b>'+recipientName+'</b>') %></p>

<p>
  <%- __('We received a request to reset the password for your account.') %>
  <%- __('If you made this request, click the button below.') %>
  <%- __('If you didn\'t make this request, you can ignore this email.')%>
</p>

<form action="<%= resetLink %>">
  <input type="hidden" name="token" value="<%= token %>" />
  <button type="submit"><%- __('Reset your password') %></button>
</form>

<p>
  <%- __('Or use this link to reset your password:') %>
  <a href="<%= resetLink %>"> <%= resetLink %> </a>
</p>

<p>
  <%- __('Don\'t leave it too late though, this link is only available for 24 hours.') %>
</p>

<%- include('emailFooter', { __: __, locale: locale }); %>
