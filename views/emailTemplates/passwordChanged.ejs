<%- include('emailHeader', { emailTitle: emailTitle, locale: locale }); %>
<% /*
===== EMAIL BODY =====
    Required values:
        - __                Function    locale-scoped translation helper
        - emailTitle        String      Subject line used as HTML <title>
        - locale            String      ISO 639-1 locale code
        - recipientName     String      Nickname of the recipient
*/ %>

<p><%- __('Dear %s', '<b>' + recipientName + '</b>') %></p>

<p>
  <%- __('The password for your Grottocenter account has been changed.') %>
</p>

<p>
  <%- __('If you did not make this change, please contact an administrator immediately at %s.', sails.config.custom.internalEmailAddress) %>
</p>

<%- include('emailFooter', { __: __, locale: locale }); %>
