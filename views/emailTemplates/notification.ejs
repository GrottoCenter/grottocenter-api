<%- include('emailHeader', { emailTitle: emailTitle, locale: locale }); %>
  <% /*
  ===== EMAIL BODY =====

    Required values:
        - __                Function    locale-scoped translation helper
        - emailTitle        String      Subject line used as HTML <title>
        - locale            String      ISO 639-1 locale code
        - actionVerb        String      The action performed on the entity
        - entityLink        String      Entity concerned by the notification link
        - entityName        String      Entity concerned by the notification name
        - entityType        String      Entity concerned by the notification type
        - recipientName     String      Full name or nickname of the recipient
        - subscriptionName  String      The subscription name which generated this notification
        - subscriptionType  String      The subscription type which generated this notification

    Optional values:
        - isAuthorNotification  Boolean      Whether this is an author validation notification (defaults to false)
        - validationComment     String|null  Moderator's rejection comment (optional)
  */ %>

  <p>
    <%- __('Dear %s', '<b>' +recipientName+'</b>') %>
  </p>

  <p>
    <%if (entityName && actionVerb) { %>
      <%- __('%s (%s) has been %s on Grottocenter.', '<b>' + entityName +'</b>', __(entityType), '<b>' + __(actionVerb) +'</b>') %>
    <% } %>
    <%if (entityLink) { %>
      <%- __('Click the link below to know more about this modification:') %>
      <a href="<%= entityLink %>"><%= entityLink %></a>
      <% } %>
  </p>

  <% if (!isAuthorNotification) { %>
  <p>
    <%if (subscriptionType === 'country') { %>
      <%- __('You are receiving this email because of your subscription to the country %s.', '<b>' +subscriptionName+'</b>') %>
    <% } %>
    <%if (subscriptionType === 'massif') { %>
      <%- __('You are receiving this email because of your subscription to the massif %s.', '<b>' +subscriptionName+'</b>') %>
    <% } %>
  </p>
  <% } else { %>
  <p>
    <%- __('You are receiving this email because you are the author of this document.') %>
  </p>
  <% if (validationComment) { %>
  <p>
    <%- __('Reviewer comment:') %>
    <br/>
    <b><%= validationComment %></b>
  </p>
  <% } %>
  <% } %>

  <%- include('emailFooter', { __: __, locale: locale }); %>
